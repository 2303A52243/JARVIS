# ==============================================================================
# JARVIS AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file containing secrets to version control!
# ==============================================================================

# --- OpenAI / OpenRouter API Configuration ---
# Your API key from https://platform.openai.com/api-keys or https://openrouter.ai/keys
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Optional Base URL (leave empty for official OpenAI; use https://openrouter.ai/api/v1 for OpenRouter)
OPENAI_BASE_URL=

# AI Brain Chat Model (e.g., gpt-4o-mini, openai/gpt-4o-mini, google/gemini-2.0-flash-001)
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text Model for Voice Assistant
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Text-to-Speech Model and Voice (voices: alloy, echo, fable, onyx, nova, shimmer)
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# --- Language & Voice Settings ---
# Default language: 'en' (English), 'te' (Telugu), 'hi' (Hindi), or 'auto' (detect)
JARVIS_LANGUAGE=en

# Voice speech rate / speed multiplier (0.75 to 1.5)
JARVIS_VOICE_SPEED=1.0

# Wake word enabled by default (true/false) - disabled by default for privacy
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_WAKE_WORD=jarvis

# --- Directory & Storage Settings ---
# Base directory for local SQLite database, settings, and cache
JARVIS_DATA_DIR=data

# Base directory for security audit logs and operation histories
JARVIS_LOG_DIR=logs

# Log verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
JARVIS_LOG_LEVEL=INFO

# --- Security & Folder Allowlist ---
# Semicolon-separated list of absolute folder paths JARVIS is authorized to access
# Example: C:\;D:\;C:\Users\YourName\Desktop\JARVIS
JARVIS_AUTHORIZED_FOLDERS=c:\Users\SRI SAHITH\OneDrive\Desktop\JARVIS

# Full PC Control Access (true/false) - enables whole-PC control across drives, settings, apps, and automation
JARVIS_FULL_PC_ACCESS=false

# Automatic Voice Activity Detection with 3s silence auto-stop (true/false)
JARVIS_AUTO_VOICE=true

# Voice silence cutoff in seconds — how long JARVIS waits after you stop speaking
# before it processes your command (lower = more responsive, higher = allows pauses)
# Default: 1.5  |  Range: 0.5 – 5.0
JARVIS_SILENCE_STOP_SECONDS=1.5

# TTS engine mode:
#   neural  — Microsoft Edge neural voices via edge-tts (high quality, ~1.5s startup)
#   fast    — Windows SAPI offline voices (instant startup, lower quality, English only)
# Default: neural
JARVIS_TTS_MODE=neural

# Strict safety confirmation mode (true/false).
# When true, all CONTROL and ADVANCED actions require interactive user confirmation
JARVIS_REQUIRE_CONFIRMATION=true
